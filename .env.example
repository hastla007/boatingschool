APP_NAME="Bootsschul Lernplattform"
# Produktiv-Standardwerte (Sicherheitsreview M4): für die lokale
# Entwicklung lokal in der eigenen .env auf APP_ENV=local und
# APP_DEBUG=true umstellen, niemals in .env.example oder produktiv.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Sicherheitsreview M4: Standardwert ist false (sicherer Default) --
# ResolveTenant::resolveViaDevOverride() greift ohnehin nur bei
# APP_ENV=local/testing UND Request von localhost, dieser Schalter ist
# eine zusätzliche, bewusst explizit zu setzende Absicherungsebene. Für
# die lokale Entwicklung (?as_tenant=... zum Mandanten-Wechsel ohne
# eigene Subdomain) in der eigenen .env auf true setzen.
DEV_TENANT_OVERRIDE=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Zentrale Domain für den Tenant-Picker; jede Bootsschule lebt unter
# {slug}.CENTRAL_DOMAIN (siehe app/Http/Middleware/ResolveTenant.php).
CENTRAL_DOMAIN=localhost

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# debug protokolliert u. a. vollständige Request-/Exception-Details und
# verstößt gegen Datensparsamkeit; für lokale Entwicklung in der eigenen
# .env auf debug setzen (DSGVO-Review D3).
LOG_LEVEL=warning

# Laufzeitrolle des Webprozesses: least-privilege, RLS greift für sie.
# Sicherheitsreview M4: keine echten Standardpasswörter in dieser Datei --
# jede Umgebung setzt eigene, zufällig erzeugte Passwörter in ihrer eigenen
# .env (nie committen).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=boatingschool
DB_USERNAME=boatingschool_app
DB_PASSWORD=

# Owner-Rolle: nur für Migrations/Seeder/Import
# (php artisan migrate|db:seed --database=pgsql_admin). Besitzt die Tabellen
# und umgeht Row-Level-Security absichtlich. Muss vorab per Infra/Ops
# angelegt sein (CREATE ROLE erfordert CREATEROLE, siehe README).
DB_ADMIN_USERNAME=boatingschool
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produktiv per HTTPS erreichbar -- Session-Cookie darf dann nie über eine
# Klartext-HTTP-Verbindung mitgesendet werden (Sicherheitsreview M9). Für
# lokale Entwicklung über reines HTTP in der eigenen .env auf false setzen.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log schreibt jede ausgehende Mail (Passwort-Reset-Links, Einladungen,
# Verifizierungs-Links -- alles mit personenbezogenen Daten/Tokens) im
# Klartext ins Log-File, statt sie zu versenden -- für lokale Entwicklung
# in der eigenen .env auf log setzen (DSGVO-Review D3). Produktiv echte
# SMTP-Zugangsdaten unten eintragen.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
