APP_NAME="Bootsschul Lernplattform"
# Produktiv-Standardwerte (Sicherheitsreview M4): für die lokale
# Entwicklung lokal in der eigenen .env auf APP_ENV=local und
# APP_DEBUG=true umstellen, niemals in .env.example oder produktiv.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Sicherheitsreview M4: Standardwert ist false (sicherer Default) --
# ResolveTenant::resolveViaDevOverride() greift ohnehin nur bei
# APP_ENV=local/testing UND Request von localhost, dieser Schalter ist
# eine zusätzliche, bewusst explizit zu setzende Absicherungsebene. Für
# die lokale Entwicklung (?as_tenant=... zum Mandanten-Wechsel ohne
# eigene Subdomain) in der eigenen .env auf true setzen.
DEV_TENANT_OVERRIDE=false

# Bug-Review M4 (Folgefehler): request()->ip() liefert hinter JEDEM
# Reverse-Proxy (auch einem rein lokalen, z. B. nginx vor php-fpm) ohne
# diese Einstellung immer die Adresse des Proxys statt des echten
# Clients -- der Localhost-Check oben (DEV_TENANT_OVERRIDE) griff dahinter
# nie mehr. Kommagetrennte Liste der IP(s)/CIDR(s) des EIGENEN, bekannten
# Proxys eintragen (z. B. 10.0.0.0/8 für ein internes Docker-Netz) --
# bewusst NICHT "*": sonst ließe sich X-Forwarded-For von jedem beliebigen
# Client fälschen. Leer lassen, wenn kein Reverse-Proxy davorsteht.
#
# Bug-Review R4-J: betrifft nicht nur request()->ip(), sondern genauso
# request()->secure() -- ein TLS-terminierender Reverse-Proxy davor
# spricht PHP intern meist per Klartext-HTTP an, nur X-Forwarded-Proto
# verrät, dass der Browser selbst über HTTPS verbunden war. Ohne
# TRUSTED_PROXIES wird dieser Header ignoriert, request()->secure() bleibt
# dauerhaft false, und SecurityHeaders sendet den Strict-Transport-
# Security-Header nie -- obwohl die Seite für jeden Browser ausschließlich
# über HTTPS erreichbar ist. In einem solchen Aufbau also unbedingt
# setzen, nicht nur bei Bedarf an einer korrekten Client-IP.
TRUSTED_PROXIES=

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Zentrale Domain für den Tenant-Picker; jede Bootsschule lebt unter
# {slug}.CENTRAL_DOMAIN (siehe app/Http/Middleware/ResolveTenant.php).
CENTRAL_DOMAIN=localhost

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug protokolliert u. a. vollständige Request-/Exception-Details und
# verstößt gegen Datensparsamkeit; für lokale Entwicklung in der eigenen
# .env auf debug setzen (DSGVO-Review D3).
LOG_LEVEL=warning

# Laufzeitrolle des Webprozesses: least-privilege, RLS greift für sie.
# Sicherheitsreview M4: keine echten Standardpasswörter in dieser Datei --
# jede Umgebung setzt eigene, zufällig erzeugte Passwörter in ihrer eigenen
# .env (nie committen).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=boatingschool
DB_USERNAME=boatingschool_app
DB_PASSWORD=

# Owner-Rolle: nur für Migrations/Seeder/Import
# (php artisan migrate|db:seed --database=pgsql_admin). Besitzt die Tabellen
# und umgeht Row-Level-Security absichtlich. Muss vorab per Infra/Ops
# angelegt sein (CREATE ROLE erfordert CREATEROLE, siehe README).
DB_ADMIN_USERNAME=boatingschool
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Bug-Review NEU-1 (Regression, Folgefehler von R3-1): standardmäßig leer
# -- das Session-Cookie bleibt dann (Laravels Standardverhalten) an genau
# den Host gebunden, der es gesetzt hat. Eine zwischenzeitliche Fassung
# (Commit 3cd7d07) leitete hier automatisch ".CENTRAL_DOMAIN" ab (Cookie
# gilt für die zentrale Domain UND alle ihre Subdomains) -- das brach
# Custom Domains vollständig (ein zum aufgerufenen Host nicht passendes
# Domain-Attribut wird vom Browser komplett verworfen) und vergrößerte
# unnötig die Angriffsfläche (plattformweites statt Pro-Host-Cookie,
# siehe App\Support\SessionCookieDomain). Explizit setzen überschreibt
# diesen Default, falls ein Betreiber die (dann bewusst in Kauf
# genommene) plattformweite Cookie-Freigabe trotzdem will.
SESSION_DOMAIN=
# Produktiv per HTTPS erreichbar -- Session-Cookie darf dann nie über eine
# Klartext-HTTP-Verbindung mitgesendet werden (Sicherheitsreview M9). Für
# lokale Entwicklung über reines HTTP in der eigenen .env auf false setzen.
SESSION_SECURE_COOKIE=true
# Bug-Review NEU-4: NUR relevant, falls die oben erwähnte Zwischenfassung
# (3cd7d07, plattformweites Cookie) auf einer echten Umgebung (z. B.
# Staging) schon gelaufen ist, BEVOR dieser Fix dort ankommt -- Browser,
# die währenddessen eingeloggt waren, führen dann bis zu SESSION_LIFETIME
# Minuten lang sowohl das alte, plattformweite Cookie als auch ein neues,
# host-gebundenes Cookie unter demselben Namen, was zu einer Login-
# Schleife führen kann. Einmalig SESSION_COOKIE auf einen neuen Namen
# setzen (z. B. mit einem "_v2"-Suffix) macht das alte Cookie beim
# nächsten Deploy dieser betroffenen Umgebung sofort wirkungslos, ohne auf
# dessen Ablauf warten zu müssen. War die Zwischenfassung nie live (z. B.
# nie über Produktion ausgerollt), ist dieser Schritt nicht nötig.
SESSION_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log schreibt jede ausgehende Mail (Passwort-Reset-Links, Einladungen,
# Verifizierungs-Links -- alles mit personenbezogenen Daten/Tokens) im
# Klartext ins Log-File, statt sie zu versenden -- für lokale Entwicklung
# in der eigenen .env auf log setzen (DSGVO-Review D3). Produktiv echte
# SMTP-Zugangsdaten unten eintragen.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
