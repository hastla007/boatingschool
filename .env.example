APP_NAME="Bootsschul-Lernplattform"
# Produktiv-Standardwerte (Sicherheitsreview M4): für die lokale
# Entwicklung lokal in der eigenen .env auf APP_ENV=local und
# APP_DEBUG=true umstellen, niemals in .env.example oder produktiv.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Sicherheitsreview M4: Standardwert ist false (sicherer Default) --
# ResolveTenant::resolveViaDevOverride() greift ohnehin nur bei
# APP_ENV=local/testing UND Request von localhost, dieser Schalter ist
# eine zusätzliche, bewusst explizit zu setzende Absicherungsebene. Für
# die lokale Entwicklung (?as_tenant=... zum Mandanten-Wechsel ohne
# eigene Subdomain) in der eigenen .env auf true setzen.
DEV_TENANT_OVERRIDE=false

# Bug-Review M4 (Folgefehler): request()->ip() liefert hinter JEDEM
# Reverse-Proxy (auch einem rein lokalen, z. B. nginx vor php-fpm) ohne
# diese Einstellung immer die Adresse des Proxys statt des echten
# Clients -- der Localhost-Check oben (DEV_TENANT_OVERRIDE) griff dahinter
# nie mehr. Kommagetrennte Liste der IP(s)/CIDR(s) des EIGENEN, bekannten
# Proxys eintragen (z. B. 10.0.0.0/8 für ein internes Docker-Netz) --
# bewusst NICHT "*": sonst ließe sich X-Forwarded-For von jedem beliebigen
# Client fälschen. Leer lassen, wenn kein Reverse-Proxy davorsteht.
#
# Bug-Review R4-J: betrifft nicht nur request()->ip(), sondern genauso
# request()->secure() -- ein TLS-terminierender Reverse-Proxy davor
# spricht PHP intern meist per Klartext-HTTP an, nur X-Forwarded-Proto
# verrät, dass der Browser selbst über HTTPS verbunden war. Ohne
# TRUSTED_PROXIES wird dieser Header ignoriert, request()->secure() bleibt
# dauerhaft false, und SecurityHeaders sendet den Strict-Transport-
# Security-Header nie -- obwohl die Seite für jeden Browser ausschließlich
# über HTTPS erreichbar ist. In einem solchen Aufbau also unbedingt
# setzen, nicht nur bei Bedarf an einer korrekten Client-IP.
TRUSTED_PROXIES=

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

# Zentrale Domain (z. B. lernen.meine-domain.de). Jede Bootsschule ist
# standardmäßig unter CENTRAL_DOMAIN/<slug> erreichbar (kein Wildcard-DNS
# nötig, siehe ResolveTenantPath). Optional: TENANT_URL_MODE=subdomain
# zeigt und verlinkt stattdessen <slug>.CENTRAL_DOMAIN (braucht Wildcard-DNS
# und -Zertifikat). Eigene Domains der Schulen funktionieren in beiden Fällen.
CENTRAL_DOMAIN=localhost
TENANT_URL_MODE=path

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug protokolliert u. a. vollständige Request-/Exception-Details und
# verstößt gegen Datensparsamkeit; für lokale Entwicklung in der eigenen
# .env auf debug setzen (DSGVO-Review D3).
LOG_LEVEL=warning

# Laufzeitrolle des Webprozesses: least-privilege, RLS greift für sie.
# Sicherheitsreview M4: keine echten Standardpasswörter in dieser Datei --
# jede Umgebung setzt eigene, zufällig erzeugte Passwörter in ihrer eigenen
# .env (nie committen).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=boatingschool
DB_USERNAME=boatingschool_app
DB_PASSWORD=

# Owner-Rolle: nur für Migrations/Seeder/Import
# (php artisan migrate|db:seed --database=pgsql_admin). Besitzt die Tabellen
# und umgeht Row-Level-Security absichtlich. Muss vorab per Infra/Ops
# angelegt sein (CREATE ROLE erfordert CREATEROLE, siehe README).
DB_ADMIN_USERNAME=boatingschool
DB_ADMIN_PASSWORD=

# TLS zur Datenbank (gilt für beide Verbindungen, pgsql und pgsql_admin).
# Standard "prefer" hält lokale Entwicklung ohne Zertifikate lauffähig.
# Produktion: Liegt die Datenbank NICHT auf demselben Host (Socket/127.0.0.1),
# zwingend "verify-full" setzen (prüft Zertifikat und Hostnamen; die CA muss
# dem System bekannt sein bzw. per ~/.postgresql/root.crt hinterlegt sein).
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Bug-Review NEU-1 (Regression, Folgefehler von R3-1): standardmäßig leer
# -- das Session-Cookie bleibt dann (Laravels Standardverhalten) an genau
# den Host gebunden, der es gesetzt hat. Eine zwischenzeitliche Fassung
# (Commit 3cd7d07) leitete hier automatisch ".CENTRAL_DOMAIN" ab (Cookie
# gilt für die zentrale Domain UND alle ihre Subdomains) -- das brach
# Custom Domains vollständig (ein zum aufgerufenen Host nicht passendes
# Domain-Attribut wird vom Browser komplett verworfen) und vergrößerte
# unnötig die Angriffsfläche (plattformweites statt Pro-Host-Cookie,
# siehe App\Support\SessionCookieDomain). Explizit setzen überschreibt
# diesen Default, falls ein Betreiber die (dann bewusst in Kauf
# genommene) plattformweite Cookie-Freigabe trotzdem will.
SESSION_DOMAIN=
# Produktiv per HTTPS erreichbar -- Session-Cookie darf dann nie über eine
# Klartext-HTTP-Verbindung mitgesendet werden (Sicherheitsreview M9). Für
# lokale Entwicklung über reines HTTP in der eigenen .env auf false setzen.
SESSION_SECURE_COOKIE=true
# Bug-Review NEU-4: NUR relevant, falls die oben erwähnte Zwischenfassung
# (3cd7d07, plattformweites Cookie) auf einer echten Umgebung (z. B.
# Staging) schon gelaufen ist, BEVOR dieser Fix dort ankommt -- Browser,
# die währenddessen eingeloggt waren, führen dann bis zu SESSION_LIFETIME
# Minuten lang sowohl das alte, plattformweite Cookie als auch ein neues,
# host-gebundenes Cookie unter demselben Namen, was zu einer Login-
# Schleife führen kann. Einmalig SESSION_COOKIE auf einen neuen Namen
# setzen (z. B. mit einem "_v2"-Suffix) macht das alte Cookie beim
# nächsten Deploy dieser betroffenen Umgebung sofort wirkungslos, ohne auf
# dessen Ablauf warten zu müssen. War die Zwischenfassung nie live (z. B.
# nie über Produktion ausgerollt), ist dieser Schritt nicht nötig.
SESSION_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sammel-Mails (Mitteilungen, Erinnerungen, Sammel-Einladungen) laufen als
# Queue-Jobs: produktiv database (oder redis) und ein dauerhaft laufender
# Worker (deploy/supervisor-worker.conf). sync verschickt im Request.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log schreibt jede ausgehende Mail (Passwort-Reset-Links, Einladungen,
# Verifizierungs-Links -- alles mit personenbezogenen Daten/Tokens) im
# Klartext ins Log-File, statt sie zu versenden -- für lokale Entwicklung
# in der eigenen .env auf log setzen (DSGVO-Review D3). Produktiv echte
# SMTP-Zugangsdaten unten eintragen.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-kompatible Anbieter (z. B. Hetzner Object Storage, IONOS, Wasabi): Endpoint eintragen.
# Das Paket league/flysystem-aws-s3-v3 ist in composer.json enthalten.
AWS_ENDPOINT=

# Datensicherung (app:backup, täglich 03:15 per Scheduler, siehe config/backup.php
# und deploy/README.md). BACKUP_DISK=s3 kopiert jede Sicherung zusätzlich auf den
# S3-Speicher oben -- dringend empfohlen, sonst liegen Sicherungen nur auf dem Server.
BACKUP_KEEP_DAYS=14
BACKUP_DISK=
# Externe Kopien verschlüsseln (dringend empfohlen): öffentlichen Schlüssel aus
# `php artisan app:backup-keygen` eintragen, den geheimen NICHT auf dem Server ablegen.
BACKUP_ENCRYPTION_PUBLIC_KEY=
# Extern nicht vom Server aus löschen (Bucket mit Lifecycle-Regel/Object Lock): false
# BACKUP_PRUNE_REMOTE=true
# Von den Sicherungen vor einem Deploy bleiben nur die letzten N
# BACKUP_KEEP_DEPLOY=3
# app:backup:verify (monatlich): diese Tabellen müssen nach der Probe-Wiederherstellung Zeilen haben
# BACKUP_VERIFY_TABLES=migrations,tenant,app_user,tenant_user,content_question
# BACKUP_PATH=/var/backups/boatingschool
# BACKUP_PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
# BACKUP_PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore

# Fehlertracking (optional, Sentry): ohne DSN inaktiv. EU-Standort wählen
# (DSN mit ".de.sentry.io") und AVV abschließen; personenbezogene Daten und
# Request-Inhalte werden nicht übertragen (config/sentry.php).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Datenschutzerklärung der Schulen (config/privacy.php, docs/recht/): Abschnitte zu
# Videoanbieter, Fehleranalyse (nur mit SENTRY_LARAVEL_DSN) und externem
# Sicherungsspeicher. Ohne PRIVACY_VIDEO_PROVIDER entfällt der Video-Abschnitt.
# PRIVACY_VIDEO_PROVIDER="Videohost GmbH"
# PRIVACY_VIDEO_PROVIDER_COUNTRY=Deutschland
# PRIVACY_VIDEO_PROVIDER_URL=https://videohost.example/datenschutz
# PRIVACY_ERROR_TRACKING_RETENTION_DAYS=90
# PRIVACY_BACKUP_PROVIDER="Speicheranbieter GmbH, Deutschland"
# Standard: "verschlüsselt", sobald BACKUP_DISK und BACKUP_ENCRYPTION_PUBLIC_KEY gesetzt
# sind; nur zum Überschreiben (z. B. serverseitig verschlüsselter Datenträger).
# PRIVACY_BACKUPS_ENCRYPTED=false

# Löschfrist für inaktive Lernende (app:prune-inactive-learners, täglich): leer = aus.
# Lernende ohne Anmeldung/Lernaktivität seit N Monaten und ohne aktiven Kurszugang
# bekommen eine Vorwarnung per Mail und werden 30 Tage später gelöscht.
# DATA_RETENTION_INACTIVE_LEARNER_MONTHS=24

# Nie angenommene Einladungen einer Schule (gültig 7 Tage) nach N Tagen löschen
# (Standard 90, 0 = aus; docs/recht/loeschkonzept.md Nr. 31):
# DATA_RETENTION_TENANT_INVITATION_DAYS=90

# Weitere Löschfristen (app:prune-personal-data, täglich): leer = aus, Frist durch
# den Betreiber festzulegen (docs/recht/loeschkonzept.md, Nr. 16-18 und 20).
# Erledigte Shop-Ereignisse nach N Tagen löschen (nie wartende/fehlgeschlagene, nie Stornos):
# DATA_RETENTION_COMMERCE_EVENT_DAYS=90
# Angaben der Praxis-Anmeldung N Monate nach dem letzten Termin entfernen (Anmeldung bleibt):
# DATA_RETENTION_PRAXIS_SUBMISSION_MONTHS=12
# Lieferadresse der Willkommensbox N Tage nach dem Versand entfernen (Bestellung bleibt):
# DATA_RETENTION_WILLKOMMENSBOX_ADDRESS_DAYS=90
# Anmelde-Geräte (Hinweis-Mail bei neuem Gerät), die N Monate nicht gesehen wurden:
# DATA_RETENTION_KNOWN_LOGIN_DEVICE_MONTHS=12

VITE_APP_NAME="${APP_NAME}"

# Mobile-API (Lernenden-App), siehe docs/api/README.md -- Standardwerte in config/mobile_api.php
# MOBILE_API_ACCESS_TTL_MINUTES=15
# MOBILE_API_REFRESH_IDLE_DAYS=30
# MOBILE_API_REFRESH_MAX_DAYS=90
# MOBILE_API_EXPORT_TTL_MINUTES=60
# Höchstens so viele ausgelieferte Fragen je Konto und Tag (0 = aus).
# MOBILE_API_DAILY_QUESTION_LIMIT=2000
# Grundzugang: entitlement (Standard) oder logged_in (WP-Schalter: jedes Mitglied
# bekommt Vollzugriff auf alle angebotenen Kurse -- nur nach Freigabe setzen)
# MOBILE_API_DEFAULT_ACCESS=entitlement
# Mindestversion der App (ältere bekommen 426 APP_UPDATE_REQUIRED) und Store-Links
# MOBILE_API_MIN_VERSION_IOS=
# MOBILE_API_MIN_VERSION_ANDROID=
# MOBILE_API_STORE_URL_IOS=
# MOBILE_API_STORE_URL_ANDROID=
# Einmal-Anmeldung der Webansicht aus der App; Universal-Link-Pfad für die Bestätigung der Kontolöschung
# MOBILE_API_WEB_SESSION_ENABLED=true
# MOBILE_API_DELETION_CONFIRMATION_PATH=/app/konto-loeschen
# Universal Links/App Links: ohne Werte liefert die zentrale Domain keine
# /.well-known/apple-app-site-association bzw. assetlinks.json aus (kommagetrennt)
# MOBILE_API_IOS_APP_IDS=ABCDE12345.de.example.app
# MOBILE_API_ANDROID_PACKAGE=de.example.app
# MOBILE_API_ANDROID_SHA256_FINGERPRINTS=AA:BB:...
# Pfade, die die App öffnet (leer = nur die Bestätigung der Kontolöschung). Empfohlen,
# sobald die App auch Passwort-Links, Einladungen und E-Mail-Bestätigung verarbeitet
# (jeweils auch mit Schul-Slug /<slug>/…), siehe deploy/README.md Abschnitt 10:
# MOBILE_API_APP_LINK_PATHS=/app/konto-loeschen,/reset-password/*,/invitations/*/accept/*,/verify-email/*/*

# Betriebsalarme (fehlgeschlagene Sicherung, täglicher Go-live-Check); leer = Support-Adresse
# OPS_ALERT_EMAIL=
# Totmann-Schalter (Pflicht in Produktion): externer Heartbeat-Dienst (z. B.
# healthchecks.io), den der Scheduler jede Minute anpingt; bleibt der Ping aus
# (Cron/Server steht), alarmiert der Dienst. Optional eigener Ping je Sicherung.
OPS_HEARTBEAT_URL=
# OPS_BACKUP_HEARTBEAT_URL=

# Superadmin-Bereich nur unter einem eigenen Host (empfohlen im Pfad-Modus, z. B.
# admin.lernen.example.de; DNS und Zertifikat nötig). Leer = zentrale Domain.
# SUPERADMIN_HOST=

# Superadmin-Bereich nur mit Zwei-Faktor-Anmeldung (Standard: an, außer APP_ENV=local/testing)
# SUPERADMIN_REQUIRE_TWO_FACTOR=true

# Shop-Anbindung (WooCommerce), siehe docs/commerce/README.md
# COMMERCE_SHOP_ID=woocommerce
# COMMERCE_SHOP_KEY_ID=shop
# COMMERCE_SHOP_SECRET=          # ohne: Commerce-API abgeschaltet (401)
# COMMERCE_SHOP_URL=             # z. B. https://shop.example.de -- ohne: kein Ausgang App -> Shop
# COMMERCE_OUTBOUND_KEY_ID=app
# COMMERCE_OUTBOUND_SECRET=
# COMMERCE_ALERT_EMAIL=          # sonst Support-Adresse der Plattform
# COMMERCE_DAILY_CODE_LIMIT=1000 # Codes je Schule und Tag über den Shop (0 = ohne Grenze)
