# Caddy als Webserver mit automatischen Zertifikaten -- empfohlen, weil
# Bootsschulen eigene Domains eintragen können: Caddy holt für jede neue
# (Sub-)Domain beim ersten Aufruf ein Let's-Encrypt-Zertifikat, nachdem
# /tls-check bestätigt hat, dass sie zu einer aktiven Bootsschule gehört.
#
# Ablage: /etc/caddy/Caddyfile; Pfade und PHP-Version anpassen.
# DNS: A/AAAA für lernen.example.de auf den Server (Schulen standardmäßig
# unter lernen.example.de/<slug>). Optional *.lernen.example.de für
# Subdomains; eigene Domains der Schulen zeigen per CNAME auf lernen.example.de.
# Hinweis: Let's Encrypt erlaubt 50 neue Zertifikate pro Woche und Domain --
# bei sehr vielen neuen Schulen stattdessen ein Wildcard-Zertifikat per
# DNS-Challenge verwenden (Caddy-Build mit DNS-Plugin des DNS-Anbieters).

{
	email admin@example.de
	on_demand_tls {
		ask http://127.0.0.1:9180/tls-check
	}
}

# Interner Prüf-Endpunkt (nur lokal erreichbar).
http://127.0.0.1:9180 {
	bind 127.0.0.1
	root * /var/www/boatingschool/public
	php_fastcgi unix//run/php/php8.3-fpm.sock
}

# Alle Domains: zentrale Domain, Schul-Subdomains, eigene Domains.
https:// {
	tls {
		on_demand
	}
	root * /var/www/boatingschool/public
	encode zstd gzip

	# Gebaute Assets dürfen lange gecacht werden (Dateinamen mit Hash).
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi unix//run/php/php8.3-fpm.sock
	file_server

	request_body {
		max_size 25MB
	}
	log {
		output file /var/log/caddy/boatingschool.log
	}
}

# http → https
http:// {
	redir https://{host}{uri} permanent
}
