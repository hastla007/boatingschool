# Kopieren nach .env und ausfüllen (docker compose liest .env in diesem Verzeichnis).
# Registry der Images; offizielle Images: docker.io (mysql:9.7,
# wordpress:php8.5-apache, wordpress:cli-php8.5, siehe compose.yaml)
REGISTRY=docker.io

WP_URL=http://127.0.0.1:8080
WP_PORT=8080
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.test
WP_LOCALE=de_DE

MYSQL_PORT=3306
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Adresse der Plattform aus Sicht des Shops und gemeinsame Geheimnisse
# (= COMMERCE_SHOP_SECRET / COMMERCE_OUTBOUND_SECRET der App, je openssl rand -hex 32)
BS_CONNECTOR_APP_URL=http://127.0.0.1:8000
COMMERCE_SHOP_SECRET=
COMMERCE_OUTBOUND_SECRET=

# Mailpit (SMTP für Shop und App, Web-Oberfläche); 0.0.0.0 macht beides von außen erreichbar
MAILPIT_BIND=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SHOP_MAIL_FROM=shop@example.test

# Nur wenn ausgehende Verbindungen (wordpress.org) über einen Proxy laufen müssen
WPCLI_HTTPS_PROXY=
